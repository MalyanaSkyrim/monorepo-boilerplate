{
  "name": "@app/mobile-ui",
  "version": "1.0.0",
  "description": "Shared mobile UI components, design system, and GluestackUI provider for React Native apps",
  "license": "MIT",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    "./icons": "./src/icons/index.ts",
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "require": "./src/index.ts"
    },
    "./provider": {
      "types": "./src/provider/index.tsx",
      "import": "./src/provider/index.tsx",
      "require": "./src/provider/index.tsx"
    },
    "./tailwind": {
      "import": "./src/tailwind/config.cjs",
      "require": "./src/tailwind/config.cjs"
    },
    "./global.css": "./global.css",
    "./src/**/*.stories.*": "./src/**/*.stories.*"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@gluestack-ui/core": "^3.0.12",
    "@gluestack-ui/utils": "^3.0.13",
    "@gorhom/bottom-sheet": "^5.2.8",
    "@hookform/resolvers": "^5.2.2",
    "@react-native-community/datetimepicker": "^8.4.4",
    "date-fns": "^4.1.0",
    "expo-blur": "^15.0.8",
    "expo-image": "^3.0.11",
    "libphonenumber-js": "^1.12.35",
    "lucide-react-native": "^0.562.0",
    "nativewind": "^4.2.1",
    "react-hook-form": "^7.65.0",
    "react-native-confirmation-code-field": "^9.0.0",
    "react-native-element-dropdown": "^2.12.4",
    "react-native-international-phone-number": "^0.11.6",
    "react-native-svg": "15.12.1",
    "react-native-ui-datepicker": "^3.1.2",
    "tailwind-variants": "^0.1.20",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-native": "^0.81.0"
  },
  "devDependencies": {
    "@app/config": "workspace:*",
    "@types/react": "19.1.10",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-native": "^0.81.5"
  },
  "private": true
}
