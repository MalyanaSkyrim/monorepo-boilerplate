# Copy this file to `.env` at the repo root and fill in the values.
# `.env` is gitignored. Never commit real secrets.

# ----------------------------------------------------------------------------
# Database (CockroachDB via `pnpm db:start`, or any Postgres-compatible URL)
# ----------------------------------------------------------------------------
# create_table_with_schema_locked=false: CockroachDB 26.2+ locks new tables, which
# makes `prisma db push` fail when it adds indexes after creating a table.
DATABASE_URL="postgresql://root@localhost:26259/app_dev?sslmode=disable&options=-c%20create_table_with_schema_locked%3Dfalse"
TEST_DATABASE_URL="postgresql://root@localhost:26259/app_test?sslmode=disable&options=-c%20create_table_with_schema_locked%3Dfalse"
# Prisma log level: error | warn | info | query
PRISMA_VERBOSE=error

# ----------------------------------------------------------------------------
# Redis (rate limiting in the auth API; started by `pnpm db:start`)
# ----------------------------------------------------------------------------
REDIS_URL="redis://localhost:6381"

# ----------------------------------------------------------------------------
# Auth API (apps/api-auth)
# ----------------------------------------------------------------------------
API_AUTH_PORT=4000
API_AUTH_URL="http://localhost:4000"
# Shared key for service-to-service calls. Generate with: openssl rand -hex 32
API_KEY="change-me"
# Secret used to sign access tokens (JWT). Generate with: openssl rand -hex 32
AUTH_SECRET="change-me"

# Transactional email (https://resend.com). Needed for verification and reset codes.
RESEND_API_KEY=""
RESEND_FROM="App Boilerplate <no-reply@example.com>"

# Social sign-in (all optional; a provider is disabled until its values are set)
# Comma-separated Google OAuth client IDs accepted as the id_token audience.
GOOGLE_OAUTH_CLIENT_IDS=""
# iOS bundle identifier, used as the audience of native Sign in with Apple tokens.
APPLE_SIGN_IN_IOS_BUNDLE_ID=""
# Apple Services ID, used as the audience of Android (web flow) tokens.
APPLE_SIGN_IN_SERVICE_ID=""
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""

# ----------------------------------------------------------------------------
# Mobile app (apps/mobile). Restart Metro after changing EXPO_PUBLIC_* values.
# ----------------------------------------------------------------------------
EXPO_PUBLIC_APP_NAME="App Boilerplate"
# Base bundle identifier / Android package. ".staging" is appended for staging builds.
APP_BUNDLE_ID="com.example.app"
EXPO_PUBLIC_API_AUTH_URL="http://localhost:4000"
EXPO_PUBLIC_API_AUTH_PORT=4000
EXPO_PUBLIC_GOOGLE_OAUTH_WEB_CLIENT_ID=""
EXPO_PUBLIC_GOOGLE_OAUTH_IOS_CLIENT_ID=""
EXPO_PUBLIC_GOOGLE_OAUTH_ANDROID_CLIENT_ID=""
EXPO_PUBLIC_FACEBOOK_APP_ID=""
EXPO_PUBLIC_APPLE_SIGN_IN_ANDROID_SERVICE_ID=""
EXPO_PUBLIC_APPLE_SIGN_IN_ANDROID_REDIRECT_URI=""
# Leave empty to disable Sentry.
EXPO_PUBLIC_SENTRY_DSN=""
# From `eas init`; required for EAS builds and updates.
EAS_PROJECT_ID=""
APPLE_TEAM_ID=""

# ----------------------------------------------------------------------------
# Web app (apps/web)
# ----------------------------------------------------------------------------
# Meta Pixel id. Leave empty to load no tracking script.
NEXT_PUBLIC_META_PIXEL_ID=""

# ----------------------------------------------------------------------------
# Tooling (optional)
# ----------------------------------------------------------------------------
# Turborepo remote cache
TURBO_TOKEN=""
TURBO_TEAM=""
# Gemini image MCP server (tooling/gemini-image-mcp)
GEMINI_API_KEY=""
# Figma export for the design-to-code skill
FIGMA_TOKEN=""
FIGMA_FILE_KEY=""
